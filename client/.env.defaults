# Bundled default environment.
#
# This file is committed to the repository and shipped as a Flutter asset
# (see `pubspec.yaml -> flutter.assets`). It defines placeholder values
# that let the app boot in any clean clone or CI run without manual setup.
#
# These are NOT real credentials — connections to the signaling and TURN
# servers WILL fail until you provide overrides. Override paths:
#
#   1. Build-time `--dart-define`:
#        flutter run --dart-define=POCKETBASE_URL=https://signal.your.tld
#        flutter build apk --dart-define=POCKETBASE_URL=...
#      main.dart pushes any non-empty `String.fromEnvironment(...)` value
#      back into `dotenv.env`, so every consumer reads the override.
#
#   2. Local edits to this file. Useful for daily development. Mark the
#      file as locally unchanged so you don't ship secrets by accident:
#        git update-index --skip-worktree client/.env.defaults
#      Revert with `git update-index --no-skip-worktree`.
#
# `.env` is NOT bundled (kept in `.gitignore`). If you must use a separate
# secrets file, add `.env` back to pubspec.yaml assets locally and create
# the file before running `flutter build`.

# PocketBase signaling backend (required for WebRTC calls and P2P setup).
# Run it on your own domain with HTTPS, see docs/POCKETBASE_SETUP.md.
POCKETBASE_URL=https://signal.stealthpro.ru

# TURN server (UDP/TCP).
TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
TURN_USERNAME=openrelayproject
TURN_PASSWORD=openrelayproject

# TURNS server (TLS on 443).
# For production use your own TLS domain in front of coturn or equivalent.
TURNS_URL=turns:CHANGE_ME.example:443?transport=tcp
TURNS_USERNAME=
TURNS_PASSWORD=
