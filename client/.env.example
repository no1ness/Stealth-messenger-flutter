# Supabase public client configuration
# Copy this file to `.env` and replace the placeholders with values from your
# own Supabase project. Used сейчас для контактов и истории; миграция на
# PocketBase описана в .ai-factory/plans/pocketbase-signaling.md.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Do not place service-role credentials in the Flutter client.
# SUPABASE_SERVICE_ROLE_KEY=server-only

# PocketBase signaling backend (REQUIRED for calls)
# Поднимается отдельно (Docker/MikroTik/VPS) — см. docs/POCKETBASE_SETUP.md.
POCKETBASE_URL=https://signal.example.com

# TURN-сервер (UDP/TCP, любой порт)
TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
TURN_USERNAME=openrelayproject
TURN_PASSWORD=openrelayproject

# TURNS-сервер для обхода ТСПУ в РФ (TLS на 443).
# Добавляется отдельным iceServer поверх TURN. Можно задать ТОЛЬКО TURNS,
# тогда обычный TURN пропускается. Для production-настройки нужен свой
# домен с TLS, проксированный на TURN-сервер (например, coturn за Caddy).
TURNS_URL=turns:CHANGE_ME.example:443?transport=tcp
TURNS_USERNAME=
TURNS_PASSWORD=
