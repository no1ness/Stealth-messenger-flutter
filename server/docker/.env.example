# Copy to .env and fill in before running scripts/install.sh
#
#   cp .env.example .env
#   nano .env

SIGNAL_DOMAIN=signal.stealthpro.ru
WEB_DOMAIN=app.stealthpro.ru
DASHBOARD_DOMAIN=dashboard.stealthpro.ru
TURN_DOMAIN=turn.stealthpro.ru
VPS_PUBLIC_IP=203.0.113.10
TURN_USERNAME=stealth
TURN_PASSWORD=change-me-to-a-strong-password
DEPLOY_DIR=

# Sing-box VLESS-Reality (required)
# Generate keys via: scripts/generate-vless-keys.sh
VLESS_UUID=change-me-to-a-uuid
VLESS_PRIVATE_KEY=change-me-to-private-key
VLESS_SHORT_ID=change-me-to-8-hex-chars

# DNS API token for Let's Encrypt DNS-01 challenge (required for HTTPS)
# Cloudflare: https://dash.cloudflare.com/profile/api-tokens (DNS:Edit)
DNS_API_TOKEN=

# Fallback ports (443 is owned by sing-box)
WEB_FALLBACK_PORT=8445
DASHBOARD_FALLBACK_PORT=8446
