# Copy to .env and fill in before running scripts/install.sh
#
#   cp .env.example .env
#   nano .env

# Public DNS names (A records must point to VPS_PUBLIC_IP before install)
SIGNAL_DOMAIN=signal.example.com
TURN_DOMAIN=turn.example.com

# VPS public IPv4 (coturn external-ip)
VPS_PUBLIC_IP=203.0.113.10

# TURN static credentials (must match client --dart-define)
TURN_USERNAME=stealth
TURN_PASSWORD=change-me-to-a-strong-password

# Where install.sh materializes the live stack (default: ~/stealth-server)
DEPLOY_DIR=
